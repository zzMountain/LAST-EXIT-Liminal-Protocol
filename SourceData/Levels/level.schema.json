{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://last-exit.local/prototype/level-config-v0.4.schema.json",
  "title": "LAST EXIT prototype LevelConfig (five rows, three fixed bus-size classes)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "level_id",
    "level_index",
    "grid",
    "queues",
    "buses",
    "rows",
    "cctv_charges",
    "initial_stability",
    "target_cctv_uses",
    "reference_solution",
    "next_bus_queue"
  ],
  "properties": {
    "schema_version": {
      "const": "0.4"
    },
    "status": {
      "const": "prototype_candidate"
    },
    "level_id": {
      "type": "string",
      "pattern": "^LEVEL-(0[1-9]|1[0-5])$"
    },
    "level_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "corridors"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 10,
          "maximum": 30
        },
        "corridors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "A",
            "B",
            "C",
            "D"
          ],
          "properties": {
            "A": {
              "type": "integer",
              "minimum": 0
            },
            "B": {
              "type": "integer",
              "minimum": 0
            },
            "C": {
              "type": "integer",
              "minimum": 0
            },
            "D": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "queues": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "passengers"
        ],
        "properties": {
          "id": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "passengers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "route",
                "kind"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "route": {
                  "enum": [
                    "R",
                    "T",
                    "B",
                    "G"
                  ]
                },
                "kind": {
                  "enum": [
                    "human",
                    "echo"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "buses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "route",
          "class",
          "footprint_cells",
          "capacity",
          "initial_left_x"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "enum": [
              "R",
              "T",
              "B",
              "G"
            ]
          },
          "class": {
            "enum": [
              "MINI",
              "STANDARD",
              "LONG"
            ]
          },
          "footprint_cells": {
            "enum": [
              2,
              3,
              4
            ]
          },
          "capacity": {
            "enum": [
              2,
              4,
              6
            ]
          },
          "initial_left_x": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "initial_bus_id"
        ],
        "properties": {
          "id": {
            "enum": [
              "R1",
              "R2",
              "R3",
              "R4",
              "R5"
            ]
          },
          "initial_bus_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cctv_charges": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "initial_stability": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "target_cctv_uses": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "reference_solution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "row",
              "left_x"
            ],
            "properties": {
              "action": {
                "const": "move"
              },
              "row": {
                "enum": [
                  "R1",
                  "R2",
                  "R3",
                  "R4",
                  "R5"
                ]
              },
              "left_x": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "enum": [
                  "scan",
                  "risk"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "queue"
            ],
            "properties": {
              "action": {
                "const": "quarantine"
              },
              "queue": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              }
            }
          }
        ]
      }
    },
    "next_bus_queue": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
